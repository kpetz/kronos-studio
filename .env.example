# Copy to .env and fill in. Never commit .env.

# Gemini TTS (voices). Create the key in Google AI Studio on a project WITHOUT billing.
GEMINI_API_KEY=

# Freesound (CC0 sound effect search). Free API key from freesound.org.
FREESOUND_API_KEY=

# Browser used for rendering. Leave empty to use an installed Google Chrome.
# Set a path to choose another browser, or "remotion" for Remotion's own download.
KRONOS_BROWSER_EXECUTABLE=
